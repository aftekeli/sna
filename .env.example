# App runtime
APP_ENV=development
APP_DEBUG=true
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000
RUNTIME_STORAGE_ROOT=

# Groq API - https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODE=free
GROQ_REQUEST_PACING_RPM=12

# Neo4j Aura - https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=xxxxxxxx
AURA_INSTANCENAME=Instance01

# Optional local Ollama fallback metadata
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Frontend/backend integration
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://127.0.0.1:8000
BACKEND_API_BASE_URL=http://127.0.0.1:8000

# Optional deployment helper; never commit a real token.
VERCEL_TOKEN=<your-vercel-token>
